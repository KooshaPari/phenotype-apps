[package]
name = "kvirtualstage"
version = "0.1.0"
edition = "2021"
description = "A Playwright-equivalent desktop automation platform for AI agents"
authors = ["KVirtualStage Team"]
license = "MIT"
repository = "https://github.com/KooshaPari/KVirtualStage"
homepage = "https://kvirtualstage.dev"
keywords = ["automation", "desktop", "virtualization", "ai", "playwright"]
categories = ["command-line-utilities", "development-tools", "virtualization"]

[dependencies]
# Core framework
tokio = { version = "1.0", features = ["full"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
anyhow = "1.0"
thiserror = "1.0"
uuid = { version = "1.0", features = ["v4", "serde"] }
chrono = { version = "0.4", features = ["serde"] }
url = "2.4"
dirs = "5.0"
futures = "0.3"
num_cpus = "1.16"

# Language bindings
pyo3 = { version = "0.20", features = ["extension-module"], optional = true }
napi = { version = "2.0", optional = true }
napi-derive = { version = "2.0", optional = true }
node-bindgen = { version = "6.1", optional = true }

# WebSocket and streaming
tungstenite = "0.21"
tokio-tungstenite = "0.21"
broadcast = "0.1"

# CLI and TUI
clap = { version = "4.0", features = ["derive"] }
ratatui = { version = "0.28", optional = true }
crossterm = { version = "0.27", optional = true }

# HTTP and Web (optimized)
axum = { version = "0.7", default-features = false, features = ["tokio", "json", "http1", "http2"], optional = true }
tower = { version = "0.4", default-features = false, features = ["util"], optional = true }
tower-http = { version = "0.5", default-features = false, features = ["cors"], optional = true }
hyper = { version = "1.0", default-features = false, features = ["http1"], optional = true }
reqwest = { version = "0.11", default-features = false, features = ["json", "rustls-tls", "multipart"] }

# Container orchestration (optimized)
bollard = { version = "0.16", default-features = false, features = ["ssl"] }
k8s-openapi = { version = "0.20", features = ["v1_22"], optional = true }
kube = { version = "0.87", features = ["runtime", "derive"], optional = true }

# Audio/Video (optional for cross-platform compatibility)
gstreamer = { version = "0.21", optional = true }
gstreamer-video = { version = "0.21", optional = true }
gstreamer-audio = { version = "0.21", optional = true }
libpulse-binding = { version = "2.28", optional = true }

# UI automation
x11 = { version = "2.21", optional = true }
wayland-client = { version = "0.31", optional = true }
image = "0.24"
screenshots = { version = "0.7", optional = true }

# Security and crypto
ring = "0.17"
argon2 = "0.5"
aes-gcm = "0.10"
base64 = "0.21"
sha2 = "0.10"

# Additional dependencies for new modules
fastrand = "2.0"
urlencoding = "2.1"
async-trait = "0.1"
users = "0.11"
rand = "0.8"

# Database (optimized)
sqlx = { version = "0.7", default-features = false, features = ["runtime-tokio-rustls", "sqlite", "json"], optional = true }
redis = { version = "0.24", default-features = false, features = ["tokio-comp"], optional = true }

# Configuration
config = "0.13"
toml = "0.8"

# Logging
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }

# Testing
criterion = "0.5"

[dev-dependencies]
tokio-test = "0.4"
tempfile = "3.0"
futures = "0.3"

[features]
default = ["tui"]
# Core features
tui = ["ratatui", "crossterm"]
web-ui = ["axum", "tower", "tower-http", "hyper"]
database = ["sqlx", "redis"]
# Language bindings
python-bindings = ["pyo3"]
nodejs-bindings = ["napi", "napi-derive"]
c-ffi = []
# Platform features
kubernetes = ["kube", "k8s-openapi"]
wayland = ["wayland-client"]
x11-support = ["x11", "screenshots"]
audio-support = ["gstreamer", "gstreamer-video", "gstreamer-audio", "libpulse-binding"]
# Combined features
full-desktop = ["x11-support", "audio-support"]
full-server = ["web-ui", "database"]
enterprise = ["full-server", "kubernetes"]
all-bindings = ["python-bindings", "nodejs-bindings", "c-ffi"]
# Performance features
gpu-acceleration = []
performance-optimized = []

[[bin]]
name = "kvirtualstage"
path = "src/main.rs"

[[bin]]
name = "kvs-demo"
path = "src/bin/demo.rs"

[[bin]]
name = "kvs-server"
path = "src/bin/server.rs"

[[bin]]
name = "kvs-tui"
path = "src/bin/tui.rs"

[lib]
name = "kvirtualstage"
crate-type = ["cdylib", "rlib"]

[profile.release]
# Maximum optimization settings for enterprise deployment
lto = "fat"                    # Full link-time optimization
codegen-units = 1              # Single codegen unit for better optimization
panic = "abort"                # Remove panic handling overhead
strip = "symbols"              # Strip all debug symbols
opt-level = 3                  # Maximum optimization level
overflow-checks = false        # Disable overflow checks for performance
debug = false                  # No debug info
debug-assertions = false       # Disable debug assertions
rpath = false                  # Disable rpath for smaller binary

[profile.release-with-debug]
inherits = "release"
debug = "line-tables-only"     # Minimal debug info for profiling
strip = false

[profile.performance]
inherits = "release"
# Ultra-optimized profile for maximum performance
lto = "fat"
codegen-units = 1
panic = "abort"
opt-level = 3
overflow-checks = false
debug = false
debug-assertions = false
# Target-specific optimizations will be set via RUSTFLAGS

[profile.size-optimized]
inherits = "release"
# Profile optimized for smallest binary size
opt-level = "z"               # Optimize for size
lto = "fat"
codegen-units = 1
panic = "abort"
strip = "symbols"