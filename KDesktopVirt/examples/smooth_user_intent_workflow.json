        {
          "action": "key_combination",
          "keys": ["alt", "F2"]
        },
        {
          "action": "wait",
          "duration": 800
        },
        {
          "action": "key_combination",
          "keys": ["ctrl", "a"]
        },
        {
          "action": "key_press",
          "key": "Delete"
        },
        {
          "action": "wait",
          "duration": 300
        },
        {
          "action": "type_text",
