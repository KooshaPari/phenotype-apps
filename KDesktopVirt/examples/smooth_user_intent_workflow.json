        },
        {
          "action": "smooth_move_cursor",
          "from": {"x": 50, "y": 1030},
          "to": {"x": 960, "y": 540},
          "duration": 1500,
          "interpolation": "smooth_curve",
          "description": "Back to center"
        },
        {
          "action": "circular_cursor_pattern",
          "center": {"x": 960, "y": 540},
          "radius": 200,
          "revolutions": 1.5,
          "duration": 3000,
