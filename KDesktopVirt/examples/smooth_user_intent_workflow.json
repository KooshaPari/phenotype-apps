{
  "name": "Smooth User Intent Workflow Demo",
  "description": "Comprehensive user intent automation with smooth cursor movement and realistic workflows",
  "version": "1.0",
  "metadata": {
    "created": "2025-07-11",
    "platform": "Virtual Desktop (XFCE)",
    "kvirtualstage_version": "0.1.0",
    "demo_type": "user_intent_validation",
    "cursor_movement": "smooth_interpolated",
    "resolution": "1920x1080"
  },
  "workflow": [
    {
      "step": 1,
      "name": "Initial Desktop Setup",
      "action": "take_screenshot",
      "output": "/tmp/01_initial_desktop.png",
      "description": "Capture initial clean desktop state"
    },
    {
      "step": 2,
      "name": "Smooth Cursor Movement to Center",
      "action": "smooth_move_cursor",
      "from": {"x": 100, "y": 100},
      "to": {"x": 960, "y": 540},
      "duration": 1500,
      "interpolation": "bezier_curve",
      "description": "Demonstrate smooth cursor movement to screen center"
    },
    {
      "step": 3,
      "name": "User Intent 1: Calculate Quarterly Budget",
      "description": "Business workflow: Calculate 150 employees × $25 lunch + $1000 room rental",
      "actions": [
        {
          "action": "smooth_move_cursor",
          "from": {"x": 960, "y": 540},
          "to": {"x": 100, "y": 50},
          "duration": 1000,
          "interpolation": "smooth_ease_in_out",
          "description": "Move to launcher area"
        },
        {
          "action": "key_combination",
          "keys": ["alt", "F2"],
          "description": "Open application launcher"
        },
        {
          "action": "wait",
          "duration": 800
        },
        {
          "action": "key_combination",
          "keys": ["ctrl", "a"],
          "description": "Select all text in launcher"
        },
        {
          "action": "key_press",
          "key": "Delete",
          "description": "Clear launcher text"
        },
        {
          "action": "wait",
          "duration": 300
        },
        {
          "action": "type_text",
          "text": "galculator",
          "typing_speed": "human_realistic",
          "description": "Type calculator application name"
        },
        {
          "action": "wait",
          "duration": 500
        },
        {
          "action": "key_press",
          "key": "Return",
          "description": "CRITICAL FIX: Press Enter to launch app (no search bar stuck text)"
        },
        {
          "action": "wait",
          "duration": 2000,
          "description": "Wait for calculator to fully load"
        }
      ]
    },
    {
      "step": 4,
      "name": "Smooth Movement to Calculator",
      "action": "find_and_move_to_window",
      "target": "galculator",
      "movement_type": "smooth_curve",
      "duration": 1200,
      "description": "Locate calculator window and move cursor smoothly to it"
    },
    {
      "step": 5,
      "name": "Business Calculation with Smooth Cursor",
      "description": "Perform budget calculation with visible cursor movements",
      "actions": [
        {
          "action": "take_screenshot",
          "output": "/tmp/02_calculator_opened.png",
          "description": "Calculator successfully launched"
        },
        {
          "action": "smooth_click_sequence",
          "clicks": [
            {"x": 50, "y": 80, "button": "1", "duration": 200},
            {"x": 90, "y": 80, "button": "5", "duration": 200},
            {"x": 130, "y": 80, "button": "0", "duration": 200},
            {"x": 170, "y": 120, "button": "×", "duration": 300},
            {"x": 90, "y": 120, "button": "2", "duration": 200},
            {"x": 90, "y": 80, "button": "5", "duration": 200},
            {"x": 170, "y": 160, "button": "+", "duration": 300},
            {"x": 50, "y": 80, "button": "1", "duration": 200},
            {"x": 130, "y": 80, "button": "0", "duration": 200},
            {"x": 130, "y": 80, "button": "0", "duration": 200},
            {"x": 130, "y": 80, "button": "0", "duration": 200},
            {"x": 170, "y": 200, "button": "=", "duration": 500}
          ],
          "description": "Calculate: 150 × 25 + 1000 with smooth cursor movement between buttons"
        },
        {
          "action": "wait",
          "duration": 1500
        },
        {
          "action": "take_screenshot",
          "output": "/tmp/03_budget_calculated.png",
          "description": "Budget calculation result: $4750"
        }
      ]
    },
    {
      "step": 6,
      "name": "User Intent 2: Document Meeting Results",
      "description": "Create meeting documentation with calculated budget",
      "actions": [
        {
          "action": "smooth_move_cursor",
          "from": "current_position",
          "to": {"x": 100, "y": 50},
          "duration": 1000,
          "interpolation": "smooth_ease_in_out",
          "description": "Move back to launcher for text editor"
        },
        {
          "action": "key_combination",
          "keys": ["alt", "F2"],
          "description": "Open launcher again"
        },
        {
          "action": "wait",
          "duration": 800
        },
        {
          "action": "key_combination",
          "keys": ["ctrl", "a"]
        },
        {
          "action": "key_press",
          "key": "Delete"
        },
        {
          "action": "wait",
          "duration": 300
        },
        {
          "action": "type_text",
          "text": "mousepad",
          "typing_speed": "human_realistic",
          "description": "Type text editor name"
