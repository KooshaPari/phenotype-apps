        {
          "action": "key_press",
          "key": "Return",
          "description": "CRITICAL FIX: Press Enter to launch file manager"
        },
        {
          "action": "wait",
          "duration": 2000
        }
      ]
    },
    {
      "step": 10,
      "name": "Smooth Movement to File Manager",
      "action": "find_and_move_to_window",
      "target": "thunar",
      "movement_type": "smooth_curve",
      "duration": 1200,
      "description": "Move cursor smoothly to file manager"
    },
    {
      "step": 11,
      "name": "Comprehensive Cursor Movement Showcase",
      "description": "Demonstrate smooth cursor movement across full 1920x1080 screen",
      "actions": [
        {
          "action": "take_screenshot",
          "output": "/tmp/06_file_manager_opened.png",
          "description": "File manager successfully launched"
        },
        {
