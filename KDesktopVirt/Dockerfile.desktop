# Full desktop environment KVirtualStage image
# Includes complete desktop environment for advanced automation

FROM rust:1.76-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libsqlite3-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy and build (same as main Dockerfile)
COPY Cargo.toml Cargo.lock ./
RUN mkdir src && \
    echo "fn main() {}" > src/main.rs && \
    echo "" > src/lib.rs && \
    cargo build --release && \
    rm -rf src target/release/deps/kvirtualstage*

COPY src ./src
RUN cargo build --release --all-features && \
    strip target/release/kvirtualstage

# Desktop runtime stage with full environment
FROM ubuntu:22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install desktop environment and dependencies
RUN apt-get update && apt-get install -y \
    # Core system
    ca-certificates \
    curl \
    wget \
    gnupg \
    # Desktop environment (KDE Plasma)
    kde-plasma-desktop \
    plasma-workspace \
    kwin-x11 \
    plasma-nm \
    dolphin \
    konsole \
    # Display server
    xorg \
    xserver-xorg-video-dummy \
    x11-xserver-utils \
    # VNC server
    tigervnc-standalone-server \
    tigervnc-common \
    # Audio system
    pulseaudio \
    pipewire \
    pipewire-pulse \
    pipewire-alsa \
    wireplumber \
    alsa-utils \
    # Multimedia
    ffmpeg \
    vlc \
    # Browsers for testing
    firefox \
    chromium-browser \
    # Development tools
    git \
    vim \
    nano \
    htop \
    # UI automation tools
    xdotool \
    xclip \
    scrot \
    # Docker client
    docker.io \
    # Network tools
    netcat-openbsd \
    net-tools \
    # Process management
    supervisor \
    dbus-x11 \
    && rm -rf /var/lib/apt/lists/*

# Setup VNC and display
RUN mkdir -p /root/.vnc && \
    echo "kvirtualstage" | vncpasswd -f > /root/.vnc/passwd && \
    chmod 600 /root/.vnc/passwd

# Create app user and add to groups
RUN useradd -r -s /bin/bash -m -d /app kvirtualstage && \
    usermod -aG docker,audio,video kvirtualstage && \
    mkdir -p /app/.vnc && \
    echo "kvirtualstage" | vncpasswd -f > /app/.vnc/passwd && \
    chmod 600 /app/.vnc/passwd && \
    chown kvirtualstage:kvirtualstage /app/.vnc/passwd

# Setup desktop environment for user
RUN mkdir -p /app/.config /app/.local/share && \
    chown -R kvirtualstage:kvirtualstage /app/.config /app/.local

# Copy binary
COPY --from=builder /app/target/release/kvirtualstage /usr/local/bin/kvirtualstage
RUN chmod +x /usr/local/bin/kvirtualstage

# Copy desktop configuration files
COPY docker/desktop/ /app/desktop/
COPY docker/supervisord-desktop.conf /etc/supervisor/conf.d/kvirtualstage.conf
COPY docker/entrypoint-desktop.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Create application directories
RUN mkdir -p /app/.kvirtualstage \
    /app/sessions \
    /app/recordings \
    /app/screenshots \
    /app/vault \
    /app/Desktop \
    && chown -R kvirtualstage:kvirtualstage /app

# Setup X11 and VNC configuration
COPY docker/xstartup /app/.vnc/xstartup
RUN chmod +x /app/.vnc/xstartup && \
    chown kvirtualstage:kvirtualstage /app/.vnc/xstartup

# Configure audio system
RUN mkdir -p /app/.config/pipewire && \
    cp /usr/share/pipewire/pipewire.conf /app/.config/pipewire/ && \
    chown -R kvirtualstage:kvirtualstage /app/.config

# Switch to app user
USER kvirtualstage
WORKDIR /app

# Initialize KVirtualStage
RUN kvirtualstage config init

# Create desktop shortcuts
RUN mkdir -p /app/Desktop && \
    echo "[Desktop Entry]" > /app/Desktop/KVirtualStage.desktop && \
    echo "Name=KVirtualStage" >> /app/Desktop/KVirtualStage.desktop && \
    echo "Exec=konsole -e kvirtualstage start --ui" >> /app/Desktop/KVirtualStage.desktop && \
    echo "Icon=utilities-terminal" >> /app/Desktop/KVirtualStage.desktop && \
    echo "Type=Application" >> /app/Desktop/KVirtualStage.desktop && \
    chmod +x /app/Desktop/KVirtualStage.desktop

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD kvirtualstage status && pgrep Xvnc || exit 1

# Expose ports (VNC + KVirtualStage)
EXPOSE 3000 3001 5900 5901

# Environment
ENV DISPLAY=:1
ENV VNC_RESOLUTION=1920x1080
ENV VNC_DEPTH=24
ENV RUST_LOG=info
ENV QT_QPA_PLATFORM=xcb

# Labels
LABEL org.opencontainers.image.title="KVirtualStage Desktop" \
      org.opencontainers.image.description="KVirtualStage with full KDE desktop environment for advanced automation" \
      org.opencontainers.image.vendor="KVirtualStage Team"

# Entry point
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["desktop"]