# Minimal KVirtualStage image without UI dependencies
# Suitable for API-only deployments and MCP server usage

FROM rust:1.76-slim as builder

# Install minimal build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libsqlite3-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy dependency files
COPY Cargo.toml Cargo.lock ./

# Create dummy source for dependency caching
RUN mkdir src && \
    echo "fn main() {}" > src/main.rs && \
    echo "" > src/lib.rs

# Build dependencies without default features
RUN cargo build --release --no-default-features && \
    rm -rf src target/release/deps/kvirtualstage*

# Copy source code
COPY src ./src

# Build minimal binary
RUN cargo build --release --no-default-features && \
    strip target/release/kvirtualstage

# Minimal runtime stage
FROM debian:bookworm-slim

# Install only essential runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN useradd -r -s /bin/bash -m -d /app kvirtualstage

# Create directories
RUN mkdir -p /app/.kvirtualstage \
    /app/vault \
    && chown -R kvirtualstage:kvirtualstage /app

# Copy binary
COPY --from=builder /app/target/release/kvirtualstage /usr/local/bin/kvirtualstage
RUN chmod +x /usr/local/bin/kvirtualstage

# Copy minimal configuration
COPY docker/minimal-config.toml /app/.kvirtualstage/config.toml
RUN chown kvirtualstage:kvirtualstage /app/.kvirtualstage/config.toml

# Switch to app user
USER kvirtualstage
WORKDIR /app

# Initialize minimal configuration
RUN kvirtualstage config init

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD kvirtualstage status || exit 1

# Expose MCP port only
EXPOSE 3001

# Environment
ENV RUST_LOG=info
ENV KVIRTUALSTAGE_CONFIG_PATH=/app/.kvirtualstage/config.toml

# Labels
LABEL org.opencontainers.image.title="KVirtualStage Minimal" \
      org.opencontainers.image.description="Minimal KVirtualStage image for API and MCP server usage" \
      org.opencontainers.image.vendor="KVirtualStage Team"

# Default command for MCP server
CMD ["mcp", "start", "--port", "3001"]