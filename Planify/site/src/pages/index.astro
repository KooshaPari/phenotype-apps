---
// planify.space landing — generated from data/config.json
// Self-contained: no external component dependencies

import config from '../../data/config.json';
import HeroScene from '../components/HeroScene.astro';

const { name, slug, domain, description, tier, repo, language, license, status, features, links } = config;

const tagline = description?.split('.')[0] + '.' || `${name} — Phenotype ecosystem project`;
const brand = { name, tagline, domain };
const hero = {
  title: name,
  subtitle: tagline,
  cta: { text: 'Get Started', href: links?.github || `https://github.com/${repo}` }
};
const featureSection = {
  title: 'Features',
  items: features?.map((f) => ({ title: f, description: '' })) || []
};
const ctaSection = {
  title: `Explore ${name}`,
  actions: [
    { text: 'GitHub', href: links?.github || `https://github.com/${repo}` },
    { text: 'Docs', href: links?.docs || `https://${domain}/docs` },
    { text: 'Releases', href: links?.releases || `https://github.com/${repo}/releases` },
    { text: 'Upstream Plane', href: links?.upstream || 'https://github.com/makeplane/plane' }
  ]
};
const footer = { brand: name, repo: repo, year: 2026 };
const header = {
  brand: name,
  nav: [
    { label: 'Home', href: '/' },
    { label: 'GitHub', href: links?.github || `https://github.com/${repo}` },
    { label: 'Upstream', href: links?.upstream || 'https://github.com/makeplane/plane' }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{brand.name}</title>
  <meta name="description" content={brand.tagline}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body class="bg-slate-950 text-slate-100">
  <!-- Header -->
  <header class="border-b border-slate-800">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="text-xl font-bold tracking-tight">{header.brand}</a>
      <nav class="flex gap-6">
        {header.nav.map((item) => (
          <a href={item.href} class="text-sm text-slate-400 hover:text-white transition-colors">{item.label}</a>
        ))}
      </nav>
    </div>
  </header>

  <!-- Hero with 3D scene -->
  <section class="relative py-24 px-6 overflow-hidden">
    <div class="absolute inset-0 opacity-60 pointer-events-none">
      <HeroScene />
    </div>
    <div class="relative max-w-4xl mx-auto text-center">
      <h1 class="text-5xl md:text-6xl font-bold tracking-tight mb-6">{hero.title}</h1>
      <p class="text-xl text-slate-400 mb-10 max-w-2xl mx-auto">{hero.subtitle}</p>
      <a href={hero.cta.href} class="inline-flex items-center gap-2 bg-slate-100 text-slate-900 px-6 py-3 rounded-lg font-semibold hover:bg-white transition-colors">
        {hero.cta.text}
      </a>
      <div class="mt-6 flex items-center justify-center gap-4 text-sm text-slate-500">
        <span>{language}</span>
        <span class="text-slate-700">|</span>
        <span>{license}</span>
        <span class="text-slate-700">|</span>
        <span class="text-emerald-400">{status}</span>
        <span class="text-slate-700">|</span>
        <span class="text-amber-400">{tier}</span>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-20 px-6 border-t border-slate-800">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold mb-12 text-center">{featureSection.title}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featureSection.items.map((item, index) => (
          <div class="p-6 rounded-xl border border-slate-800 bg-slate-900/50 hover:border-slate-700 transition-colors">
            <div class="w-10 h-10 rounded-lg bg-slate-800 flex items-center justify-center mb-4 text-slate-300 font-mono text-sm">
              {String(index + 1).padStart(2, '0')}
            </div>
            <h3 class="text-lg font-semibold mb-2">{item.title}</h3>
            {item.description && <p class="text-sm text-slate-400">{item.description}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 px-6 border-t border-slate-800">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-8">{ctaSection.title}</h2>
      <div class="flex flex-wrap items-center justify-center gap-4">
        {ctaSection.actions.map((a) => (
          <a href={a.href} class="inline-flex items-center gap-2 border border-slate-700 bg-slate-900/50 px-5 py-2.5 rounded-lg font-semibold hover:border-slate-500 hover:bg-slate-800 transition-colors">
            {a.text}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-10 px-6 border-t border-slate-800">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="text-sm text-slate-500">{footer.brand} · {footer.year}</div>
      <div class="text-sm text-slate-500">
        <a href={`https://github.com/${footer.repo}`} class="hover:text-white transition-colors">github.com/{footer.repo}</a>
      </div>
    </div>
  </footer>
</body>
</html>
